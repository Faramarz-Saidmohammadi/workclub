NODE_ENV=development
PORT=8888

MONGO_URI=mongodb://127.0.0.1:27017/workclub
MONGO_MAX_POOL_SIZE=20
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=workclub_refresh
COOKIE_SECURE=false
REQUIRE_EMAIL_VERIFICATION=false

FRONTEND_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
TRUST_PROXY=false
LOG_LEVEL=info
QUEUE_MODE=inline

# Optional services. Uncomment only after supplying valid values.
# METRICS_TOKEN=replace-with-a-private-token-at-least-16-characters
# REDIS_URL=redis://127.0.0.1:6379
# RESEND_API_KEY=re_replace_me
# EMAIL_FROM=WorkClub <notifications@example.com>
